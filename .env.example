# Optional key for Gemini AI email drafting.
GEMINI_API_KEY=

# Public URL of the Petbox Desk deployment.
APP_URL=https://your-service.onrender.com
HOST=0.0.0.0
PORT=10000

# PostgreSQL database. Use Render's Internal Database URL in production.
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
SESSION_SECRET=
# Set this to the deployed frontend origin (comma-separated if separate from the API).
CLIENT_ORIGIN=https://your-service.onrender.com
VITE_WHATSAPP_BACKEND_URL=
WHATSAPP_API_KEY=

# Optional production bootstrap users. Set these in Render Environment Variables.
ADMIN_EMAIL=admin@petboxdesk.com
ADMIN_NAME=Petbox Admin
ADMIN_PASSWORD=
SUPERVISOR_EMAIL=supervisor@petboxdesk.com
SUPERVISOR_NAME=Petbox Supervisor
SUPERVISOR_PASSWORD=
AGENT_EMAIL=agent@petboxdesk.com
AGENT_NAME=Petbox Agent
AGENT_PASSWORD=
BI_EMAIL=bi@petboxdesk.com
BI_NAME=Petbox BI
BI_PASSWORD=

# SMTP config (optional; for sending customer emails).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# HTTPS email provider (recommended on Render Free; avoids blocked SMTP ports).
RESEND_API_KEY=
RESEND_FROM=

# IMAP config (optional; for reading customer support emails).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Facebook Messenger / Meta OAuth and webhooks.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v20.0

# WhatsApp Cloud API.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Website Live Chat widget.
LIVE_CHAT_WIDGET_ID=
LIVE_CHAT_PUBLIC_KEY=
LIVE_CHAT_ALLOWED_ORIGINS=
