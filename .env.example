# GEMINI_API_KEY: Optional key for Gemini AI email drafting.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the Petbox Desk deployment.
APP_URL="MY_APP_URL"

# PostgreSQL database
DATABASE_URL="postgresql://postgres:password@localhost:5432/petbox_desk"
DB_SSL="false"
DB_POOL_MAX=10
SESSION_SECRET="replace-with-a-long-random-secret"

# SMTP Config (for sending customer emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="support@example.com"
SMTP_PASS="your-smtp-app-password"

# IMAP Config (for reading customer support emails)
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER="support@example.com"
IMAP_PASS="your-imap-app-password"

DATABASE_URL="postgresql://postgres:আপনার_POSTGRES_PASSWORD@localhost:5432/petbox_desk"
DB_SSL="false"
DB_POOL_MAX=10
SESSION_SECRET="petbox-desk-local-secret-2026"