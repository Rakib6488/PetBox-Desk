# Optional key for Gemini AI email drafting.
GEMINI_API_KEY=

# Public URL of the Petbox Desk deployment.
APP_URL=https://your-service.onrender.com

# PostgreSQL database. Use Render's Internal Database URL in production.
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
SESSION_SECRET=

# SMTP config (optional; for sending customer emails).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# IMAP config (optional; for reading customer support emails).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Facebook Messenger / Meta OAuth and webhooks.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

# WhatsApp Cloud API.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Website Live Chat widget.
LIVE_CHAT_WIDGET_ID=
LIVE_CHAT_PUBLIC_KEY=
LIVE_CHAT_ALLOWED_ORIGINS=
